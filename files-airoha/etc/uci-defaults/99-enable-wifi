#!/bin/sh
# uci-defaults run before WiFi modules finish loading, so /etc/config/wireless
# may not exist yet. The uci -q commands silently fail if sections don't exist.
# A hotplug.d/ieee80211/20-enable-wifi script handles the case where WiFi is
# detected later.
. /lib/functions.sh

uci -q set wireless.default_radio0.disabled=0
uci -q set wireless.default_radio1.disabled=0
uci -q commit wireless

exit 0
