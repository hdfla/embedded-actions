#!/bin/sh
# /etc/uci-defaults/99-enable-kv
# Enable 802.11k (RRM) and 802.11v (BSS Transition) on all wifi-iface sections.

. /lib/functions.sh

# Exit if the wireless config doesn't exist yet.
[ -f /etc/config/wireless ] || exit 0

enable_kv() {
    local section="$1"
    local type k v
    config_get type "$section" type
    [ "$type" = "wifi-iface" ] || return 0

    config_get k "$section" ieee80211k
    config_get v "$section" bss_transition

    [ "$k" = "1" ] || uci -q set wireless."$section".ieee80211k='1'
    [ "$v" = "1" ] || uci -q set wireless."$section".bss_transition='1'
}

config_load wireless
config_foreach enable_kv wifi-iface

uci -q commit wireless
exit 0
