#!/bin/sh
# Default-enable the full 802.11k/v feature set on every wifi-iface,
# including SSIDs added after first boot. Each option is only written if
# UNSET, so a manual `option X '0'` is never overwritten.

[ "$ACTION" = "add" ] || exit 0

i=0
while [ ! -f /etc/config/wireless ] && [ $i -lt 10 ]; do
	sleep 1
	i=$((i + 1))
done
[ -f /etc/config/wireless ] || exit 0

. /lib/functions.sh

CHANGED=0

apply_11kv() {
	local cfg="$1" o

	for o in ieee80211k rrm_neighbor_report rrm_beacon_report \
	         bss_transition wnm_sleep_mode wnm_sleep_mode_no_keys \
	         proxy_arp; do
		[ -z "$(uci -q get wireless.$cfg.$o)" ] \
			&& { uci -q set wireless.$cfg.$o='1'; CHANGED=1; }
	done

	[ -z "$(uci -q get wireless.$cfg.time_advertisement)" ] \
		&& { uci -q set wireless.$cfg.time_advertisement='2'; CHANGED=1; }
}

config_load wireless
config_foreach apply_11kv wifi-iface

[ "$CHANGED" = "1" ] && { uci -q commit wireless; wifi reload; }
